{
  "expo": {
    "name": "المصحف الرقمي",
    "slug": "mobile-islamic-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1B4332"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.islamicapp.quran"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B4332"
      },
      "package": "com.islamicapp.quran"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
