{
  "expo": {
    "name": "المصحف الرقمي",
    "slug": "mobile-islamic-app",
    "owner": "alqubali",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1B4332"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.islamicapp.quran",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B4332"
      },
      "package": "com.islamicapp.quran"
    },
    "extra": {
      "eas": {
        "projectId": "d7af4510-f0d7-4f27-b5a6-e89623e1bc1c"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B4332",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "أوقات الصلاة"
        }
      ]
    ]
  }
}
